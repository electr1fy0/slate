#!/bin/bash
set -euxo pipefail

mkdir -p /etc/continuum
echo "${app_role}" > /etc/continuum/role

cat > /etc/continuum/continuum.env <<ENVEOF
AWS_REGION=${region}
APP_ROLE=${app_role}
TABLE_NAME=${table_name}
CONTINUUM_ROLE_FILE=/etc/continuum/role
ADMIN_TOKEN=continuum-demo-token
ERROR_RATE_THRESHOLD=0.5
ENVEOF

dnf install -y aws-cli

aws s3 cp "s3://${bundle_bucket}/bundles/app.tar.gz" /tmp/app.tar.gz --region ${region}
mkdir -p /opt/continuum/app
tar -xzf /tmp/app.tar.gz -C /opt/continuum/app

cp /opt/continuum/app/continuum.service /etc/systemd/system/continuum.service
chmod +x /opt/continuum/app/continuum-api /opt/continuum/app/set_role.sh
systemctl daemon-reload
systemctl enable continuum
systemctl start continuum
