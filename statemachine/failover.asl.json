{
  "Comment": "Continuum: intent-verified cross-region failover with rollback and reconciliation. Every task carries a timeout; verification-infrastructure failures abort rather than trigger failover; all failure paths terminate in a Fail state.",
  "StartAt": "VerifyCheck1",
  "States": {
    "VerifyCheck1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__VERIFIER_ARN__",
        "Payload": {
          "mode": "force",
          "target": "primary"
        }
      },
      "ResultPath": "$.check1",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.verify_error",
          "Next": "NotifyFailed"
        }
      ],
      "Next": "StillDownAfterCheck1"
    },
    "StillDownAfterCheck1": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.check1.Payload.healthy",
          "BooleanEquals": false,
          "Next": "Wait45s"
        }
      ],
      "Default": "NotifyFalseAlarm"
    },
    "Wait45s": {
      "Type": "Wait",
      "Seconds": 45,
      "Next": "VerifyCheck2"
    },
    "VerifyCheck2": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__VERIFIER_ARN__",
        "Payload": {
          "mode": "force",
          "target": "primary"
        }
      },
      "ResultPath": "$.check2",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.verify_error",
          "Next": "NotifyFailed"
        }
      ],
      "Next": "StillDownAfterCheck2"
    },
    "StillDownAfterCheck2": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.check2.Payload.healthy",
          "BooleanEquals": false,
          "Next": "Wait30s"
        }
      ],
      "Default": "NotifyFalseAlarm"
    },
    "Wait30s": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "VerifyCheck3"
    },
    "VerifyCheck3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__VERIFIER_ARN__",
        "Payload": {
          "mode": "force",
          "target": "primary",
          "retry_once": true,
          "retry_delay_s": 10
        }
      },
      "ResultPath": "$.check3",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.verify_error",
          "Next": "NotifyFailed"
        }
      ],
      "Next": "ConfirmedDown"
    },
    "ConfirmedDown": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.check3.Payload.healthy",
          "BooleanEquals": false,
          "Next": "NotifyFailoverStarting"
        }
      ],
      "Default": "NotifyFalseAlarm"
    },
    "NotifyFalseAlarm": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: degradation NOT confirmed after verification. No failover. Execution {}', $$.Execution.Name)",
        "Subject": "[Continuum] Transient blip suppressed - no failover"
      },
      "TimeoutSeconds": 30,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "FailExecution"
        }
      ],
      "End": true
    },
    "NotifyFailoverStarting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: primary verified DOWN (3 checks). Starting failover workflow {}.', $$.Execution.Name)",
        "Subject": "[Continuum] FAILOVER STARTING"
      },
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "CheckReplication"
    },
    "CheckReplication": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__OPS_ARN__",
        "Payload": {
          "action": "replication_status"
        }
      },
      "ResultPath": "$.replication",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.replication_error",
          "Next": "PromoteStandby"
        }
      ],
      "Next": "PromoteStandby"
    },
    "PromoteStandby": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__OPS_ARN__",
        "Payload": {
          "action": "promote"
        }
      },
      "ResultPath": "$.promote",
      "TimeoutSeconds": 360,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.promote_error",
          "Next": "NotifyFailed"
        }
      ],
      "Next": "WaitPromotion"
    },
    "WaitPromotion": {
      "Type": "Wait",
      "Seconds": 25,
      "Next": "ForceTrafficShift"
    },
    "ForceTrafficShift": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__OPS_ARN__",
        "Payload": {
          "action": "traffic_shift",
          "inverted": true
        }
      },
      "ResultPath": "$.shift",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.shift_error",
          "Next": "NotifyFailed"
        }
      ],
      "Next": "WaitDnsPropagation"
    },
    "WaitDnsPropagation": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "VerifyStandby1"
    },
    "VerifyStandby1": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__VERIFIER_ARN__",
        "Payload": {
          "mode": "force",
          "target": "standby",
          "target_url": "__STANDBY_URL__",
          "publish_metric": false
        }
      },
      "ResultPath": "$.standby1",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.verify_error",
          "Next": "RollbackTraffic"
        }
      ],
      "Next": "StandbyHealthyAfterCheck1"
    },
    "StandbyHealthyAfterCheck1": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.standby1.Payload.healthy",
          "BooleanEquals": true,
          "Next": "ReconcileInFlightWrites"
        }
      ],
      "Default": "Wait15s"
    },
    "Wait15s": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "VerifyStandby2"
    },
    "VerifyStandby2": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__VERIFIER_ARN__",
        "Payload": {
          "mode": "force",
          "target": "standby",
          "target_url": "__STANDBY_URL__",
          "publish_metric": false
        }
      },
      "ResultPath": "$.standby2",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.verify_error",
          "Next": "RollbackTraffic"
        }
      ],
      "Next": "StandbyHealthyFinal"
    },
    "StandbyHealthyFinal": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.standby2.Payload.healthy",
          "BooleanEquals": true,
          "Next": "ReconcileInFlightWrites"
        }
      ],
      "Default": "RollbackTraffic"
    },
    "RollbackTraffic": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__OPS_ARN__",
        "Payload": {
          "action": "rollback_traffic"
        }
      },
      "ResultPath": "$.rollback",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.rollback_error",
          "Next": "NotifyRolledBack"
        }
      ],
      "Next": "NotifyRolledBack"
    },
    "NotifyRolledBack": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: standby FAILED post-promotion verification. Traffic rolled back to primary. Manual investigation required.', $$.Execution.Name)",
        "Subject": "[Continuum] FAILOVER ROLLED BACK"
      },
      "TimeoutSeconds": 30,
      "Next": "FailExecution"
    },
    "FailExecution": {
      "Type": "Fail",
      "Error": "StandbyVerificationFailed",
      "Cause": "Standby did not pass deep health checks after promotion; traffic rolled back."
    },
    "ReconcileInFlightWrites": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__RECONCILER_ARN__",
        "Payload": {}
      },
      "ResultPath": "$.reconciliation",
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.reconciliation_error",
          "Next": "NotifyReconciliationFailed"
        }
      ],
      "Next": "NotifySuccess"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: failover complete. Standby promoted, traffic shifted, reconciliation result: {}.', States.JsonToString($.reconciliation))",
        "Subject": "[Continuum] FAILOVER COMPLETE"
      },
      "TimeoutSeconds": 30,
      "End": true
    },
    "NotifyReconciliationFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: traffic is on the standby but write reconciliation FAILED in {}. Run the reconciler manually; journal entries persist for 7 days.', $$.Execution.Name)",
        "Subject": "[Continuum] RECONCILIATION FAILED - MANUAL ACTION REQUIRED"
      },
      "TimeoutSeconds": 30,
      "Next": "FailExecutionReconcile"
    },
    "FailExecutionReconcile": {
      "Type": "Fail",
      "Error": "ReconciliationFailed",
      "Cause": "Outbox replay failed after promotion; the standby serves traffic but in-flight writes were not reconciled."
    },
    "NotifyFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "__SNS_TOPIC_ARN__",
        "Message.$": "States.Format('Continuum: failover workflow {} FAILED during promotion/shift/verification. Check Step Functions execution history.', $$.Execution.Name)",
        "Subject": "[Continuum] FAILOVER WORKFLOW FAILED"
      },
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "FailExecutionWorkflow"
    },
    "FailExecutionWorkflow": {
      "Type": "Fail",
      "Error": "FailoverWorkflowFailed",
      "Cause": "The workflow hit an unrecoverable error during verification, promotion, or traffic shift; primary was left untouched unless a rollback ran."
    }
  }
}
