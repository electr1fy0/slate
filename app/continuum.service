[Unit]
Description=Continuum exam platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/continuum/app
EnvironmentFile=/etc/continuum/continuum.env
ExecStart=/opt/venv/bin/uvicorn main:app --host 0.0.0.0 --port 80 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
