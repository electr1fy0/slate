[Unit]
Description=Continuum exam platform (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/continuum/app
EnvironmentFile=/etc/continuum/continuum.env
ExecStart=/opt/continuum/app/continuum-api
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
